# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# App settings
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:3000
STORAGE_BUCKET_PRODUCTS=product-images
API_V1_PREFIX=/api/v1

# OpenRouter AI Configuration (Free Qwen Model)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# Google Books API (untuk fitur perbandingan harga)
# Buat gratis: https://console.cloud.google.com/ -> aktifkan "Books API" -> buat API key.
# Tanpa kunci ini, permintaan ke Google Books dijawab HTTP 429 (kuota anonim = 0).
# Marketplace lain (Tokopedia/Shopee/Lazada/Blibli/Bukalapak) tetap bisa dipakai
# lewat product_url yang diisi admin di /marketplace-sources.
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Service scraper Playwright (folder `scraper-service`, endpoint `POST /scrape`).
# Jalankan `uv run python -m src.api` di sana; biarkan kosong untuk memakai
# adapter bawaan saja (marketplace e-commerce akan memblokir permintaan).
SCRAPER_SERVICE_URL=http://127.0.0.1:8001
# Harus sama dengan SCRAPER_API_TOKEN di scraper-service/.env. Kosong = tanpa token.
SCRAPER_API_TOKEN=
# Batas satu panggilan scraper (detik); harus < batas total perbandingan (25 detik).
SCRAPER_TIMEOUT_SECONDS=20

# Database (SQLAlchemy/asyncpg).
# Pakai Supavisor **session mode** (port 5432) dari Dashboard Supabase ->
# Connect -> Session pooler: host `aws-0-<region>.pooler.supabase.com`,
# user `postgres.<project-ref>`. Host langsung `db.<ref>.supabase.co` menambah
# ±3 detik per koneksi baru (hanya IPv6) sehingga UI terasa membeku.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Umur maksimum koneksi pool sebelum didaur ulang (detik).
DATABASE_POOL_RECYCLE_SECONDS=1800

