# Salin ke `.env` untuk lokal. Berkas `.env*` di-ignore git, jadi nilai di sini
# TIDAK ikut ke Vercel. Untuk deploy, set variabel yang sama di
# Vercel → Project → Settings → Environment Variables (Production + Preview),
# lalu Redeploy — `NEXT_PUBLIC_*` di-inline saat build.

# URL backend. Biarkan kosong/komentari agar URL diturunkan dari host halaman:
# membuka http://192.168.1.10:3000 memanggil http://192.168.1.10:8000/api/v1.
# Isi bila backend ada di mesin/port lain, mis. http://192.168.1.10:8000/api/v1
# WAJIB diisi di Vercel dengan URL backend publik, mis.
# https://<backend>.vercel.app/api/v1 — tanpa garis miring di akhir.
# Nilai `localhost` di produksi akan ditolak/diabaikan.
# NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hanya untuk `next dev`: host tambahan yang boleh memuat aset dev saat dev
# server dibuka lewat IP LAN. Pisahkan dengan koma; cocokkan per label host.
# NEXT_DEV_ALLOWED_ORIGINS=192.168.*.*,10.*.*.*