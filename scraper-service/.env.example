# Supabase PostgreSQL Database URL (sama dengan DATABASE_URL di backend utama).
# Hanya dipakai mode cron worker (`python -m src.main`), bukan mode API.
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# --- Mode API (`python -m src.api`) ---
# Port server; backend memanggil http://<host>:<PORT>/scrape
PORT=8001
# Harus sama dengan SCRAPER_API_TOKEN di backend/.env. Kosong = tanpa token.
SCRAPER_API_TOKEN=
# Perbandingan buku yang boleh berjalan bersamaan di service ini.
MAX_CONCURRENT_SCRAPES=2

# Browser Settings
HEADLESS=true
CONCURRENCY=5
REQUEST_TIMEOUT_MS=25000

# Scraping Delays (dalam detik, untuk mencegah bot detection) — mode cron
DELAY_MIN_SECONDS=2.0
DELAY_MAX_SECONDS=5.0

# Batch limits (jumlah buku yang diproses sekali jalan, 0 = semua buku) — mode cron
MAX_BOOKS_PER_RUN=0
